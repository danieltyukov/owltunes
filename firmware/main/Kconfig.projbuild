menu "OwlTunes"

    choice OWL_BOARD
        prompt "Board"
        default OWL_BOARD_QEMU
        help
            Hardware the firmware runs on. The dev kits and the OwlTunes board are added in
            the bring-up phase.

        config OWL_BOARD_QEMU
            bool "QEMU emulator (virtual RGB panel)"
    endchoice

    config OWL_SETUP_URL
        string "Setup page address"
        default "https://danieltyukov.github.io/owltunes/setup/"
        help
            Shown as a QR code while the owl is being set up. A fork that hosts its own
            setup page changes it here.

endmenu
