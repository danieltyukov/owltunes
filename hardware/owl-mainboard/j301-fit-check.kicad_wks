( page_layout
    ( setup (textsize 2 2) (linewidth 0.15) (textlinewidth 0.2)
      (left_margin 10) (right_margin 10) (top_margin 10) (bottom_margin 10) )
    ( rect (start 0 0 ltcorner) (end 0 0 rbcorner) )
    ( tbtext "${TITLE} rev ${REVISION}, ${ISSUE_DATE}: board front at 1:1 for the J301 adapter fit check" (pos 4 6 ltcorner) (font bold (size 2.5 2.5)) (justify left) )
    ( tbtext "Print at actual size (scale 1:1), with no fit to page or shrink to fit." (pos 4 12 ltcorner) (justify left) )
    ( tbtext "Check the scale before use: each bar on the left is 10 mm, and the board outline is 61.8 mm wide and 79.8 mm tall." (pos 4 17 ltcorner) (justify left) )
    ( tbtext "Layers: Edge.Cuts, F.Cu, F.Silkscreen, F.Fab, F.Courtyard and User.Comments (the enclosure keep-outs; the adapter's is the box west of J301)." (pos 4 22 ltcorner) (justify left) )
    ( line (start 10 90 ltcorner) (end 20 90 ltcorner) (linewidth 0.3) )
    ( line (start 10 89 ltcorner) (end 10 91 ltcorner) (linewidth 0.3) )
    ( line (start 20 89 ltcorner) (end 20 91 ltcorner) (linewidth 0.3) )
    ( tbtext "10 mm" (pos 15 87 ltcorner) (justify center) )
    ( line (start 30 80 ltcorner) (end 30 90 ltcorner) (linewidth 0.3) )
    ( line (start 29 80 ltcorner) (end 31 80 ltcorner) (linewidth 0.3) )
    ( line (start 29 90 ltcorner) (end 31 90 ltcorner) (linewidth 0.3) )
    ( tbtext "10 mm" (pos 33 85 ltcorner) (justify left) )
)
